# Backend image for UAT/PRODUCTION-style deployments.
# This variant is used by docker-compose.uat.yml and docker-compose.prod.yml.
# Runtime behavior: starts app directly (`./main`) and does not install/use migrate startup script.
# Note: builder stage still includes corporate network TLS workarounds for module download.
# Build stage
FROM golang:1.24-alpine3.21 AS builder

WORKDIR /app

# Install build dependencies and ca-certificates
RUN apk add --no-cache git=2.47.3-r0 make=4.4.1-r2 ca-certificates=20250911-r0 && update-ca-certificates

# Copy go mod files
COPY go.mod ./
# Copy go.sum if it exists
COPY go.sum* ./
# Corporate network workaround for module download in restricted TLS environments
ENV GOINSECURE="*"
ENV GOPRIVATE="*"
RUN git config --global http.sslVerify false && go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main cmd/api/main.go

# Runtime stage
FROM alpine:3.21

RUN apk --no-cache add ca-certificates=20250911-r0

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/main .
COPY --from=builder /app/config.yaml ./config/config.yaml
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/data/masterdata ./backend/data/masterdata

EXPOSE 8080

CMD ["./main"]
