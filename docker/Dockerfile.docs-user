# syntax=docker/dockerfile:1

FROM node:22-alpine AS build
WORKDIR /app

# Install dependencies first for better layer caching.
COPY docs-user/package*.json ./
RUN npm ci

# Build static VitePress output.
COPY docs-user/ ./
RUN npm run docs:build

FROM nginx:1.27-alpine AS runtime

# Serve the built VitePress site at /docs-user/ path.
RUN mkdir -p /usr/share/nginx/html/docs-user
COPY --from=build /app/.vitepress/dist /usr/share/nginx/html/docs-user

EXPOSE 80
