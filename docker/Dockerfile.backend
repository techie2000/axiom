# Backend image for LOCAL DEVELOPMENT.
# This variant is used by docker-compose.dev.yml and includes corporate network TLS workarounds.
# Runtime behavior: installs `migrate` and starts via /root/start.sh (runs DB migrations, then starts app).
# Build stage
FROM golang:1.24-alpine3.21 AS builder

WORKDIR /app

# Install dependencies and ca-certificates for TLS
RUN apk add --no-cache git=2.47.3-r0 make=4.4.1-r2 ca-certificates=20250911-r0 && update-ca-certificates

# Copy go mod files
COPY go.mod ./
# Copy go.sum if it exists
COPY go.sum* ./
# Corporate network workaround for module download in restricted TLS environments
ENV GOINSECURE="*"
ENV GOPRIVATE="*"
RUN git config --global http.sslVerify false && go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main cmd/api/main.go

# Runtime stage
FROM alpine:3.21

# Install migrate binary for startup migration step in /root/start.sh
RUN apk --no-cache add ca-certificates=20250911-r0 wget=1.25.0-r0 && \
    wget --progress=dot:giga --no-check-certificate -O migrate.tar.gz https://github.com/golang-migrate/migrate/releases/download/v4.18.1/migrate.linux-amd64.tar.gz && \
    tar xvzf migrate.tar.gz && \
    mv migrate /usr/local/bin/migrate && \
    chmod +x /usr/local/bin/migrate && \
    rm migrate.tar.gz

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/main .
COPY --from=builder /app/config.yaml ./config/config.yaml
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/data/masterdata ./backend/data/masterdata

# Create startup script that runs migrations first
RUN echo '#!/bin/sh' > /root/start.sh && \
    echo "echo \"Running database migrations...\"" >> /root/start.sh && \
    echo "migrate -path /root/migrations -database \"postgres://\${DATABASE_USER}:\${DATABASE_PASSWORD}@\${DATABASE_HOST}:\${DATABASE_PORT}/\${DATABASE_NAME}?sslmode=disable\" -verbose up" >> /root/start.sh && \
    echo "echo \"Starting application...\"" >> /root/start.sh && \
    echo "exec ./main" >> /root/start.sh && \
    chmod +x /root/start.sh

EXPOSE 8080

CMD ["/root/start.sh"]