{
  "name": "axiom-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "i18n:alias-common": "node ./scripts/alias-common-i18n-values.mjs",
    "i18n:extract": "node ./scripts/extract-i18n-keys.mjs",
    "i18n:check": "node ./scripts/check-i18n-completeness.mjs",
    "i18n:verify": "npm run i18n:extract && npm run i18n:check && git diff --exit-code -- public/locales",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium",
    "check:ra-lookups": "node ./scripts/check-ra-lookups.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@radix-ui/react-slot": "^1.3.3",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.35.0",
    "next": "16.2.12",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.11.12",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  }
}
