{
  "name": "axiom-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "i18n:extract": "node ./scripts/extract-i18n-keys.mjs",
    "i18n:check": "node ./scripts/check-i18n-completeness.mjs",
    "i18n:verify": "npm run i18n:extract && npm run i18n:check && git diff --exit-code -- public/locales",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium",
    "check:ra-lookups": "node ./scripts/check-ra-lookups.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "i18next": "^25.8.16",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.303.0",
    "next": "16.2.3",
    "postcss": "^8.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.6",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.5.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
