{
  "name": "axiom-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "i18n:extract": "node ./scripts/extract-i18n-keys.mjs",
    "i18n:check": "node ./scripts/check-i18n-completeness.mjs",
    "i18n:verify": "npm run i18n:extract && npm run i18n:check && git diff --exit-code -- public/locales",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.2",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "i18next": "^25.8.16",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.303.0",
    "next": "15.5.10",
    "postcss": "^8.4.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.6",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.5.10",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
