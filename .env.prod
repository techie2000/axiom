# Production Environment Configuration
# ⚠️  SECURITY: All CHANGE_ME_REQUIRED values MUST be set to strong, unique secrets
# before deploying. Store real credentials in a secrets manager (e.g. AWS Secrets Manager,
# HashiCorp Vault, Azure Key Vault) and inject them at runtime — never commit real values.
COMPOSE_PROJECT_NAME=axiom-prod
ENVIRONMENT=prod

# Port Configuration (Prefix: 3)
POSTGRES_PORT=35432
RABBITMQ_PORT=35672
RABBITMQ_MGMT_PORT=35673
BACKEND_PORT=38080
FRONTEND_PORT=33000

# Database Configuration
POSTGRES_USER=axiom
# ⚠️  Set a strong, unique password before deploying. Never commit real credentials.
# Existing initialized production volumes keep the original DB user password.
# Rotate credentials with ALTER USER (or reset the volume) before changing this value.
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED
POSTGRES_DB=axiom_prod

# RabbitMQ Configuration
# ⚠️  Replace with a strong, unique user and password before deploying.
RABBITMQ_DEFAULT_USER=CHANGE_ME_REQUIRED
RABBITMQ_DEFAULT_PASS=CHANGE_ME_REQUIRED

# Backend Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=axiom
# ⚠️  Must match POSTGRES_PASSWORD above.
# Existing initialized production volumes keep the original DB user password.
# Rotate credentials with ALTER USER (or reset the volume) before changing this value.
DATABASE_PASSWORD=CHANGE_ME_REQUIRED
DATABASE_LOGLEVEL=warn  # Options: silent, error, warn, info
DATABASE_NAME=axiom_prod
LEI_DATADIR=/root/data/lei

# LEI Sync Schedules (all optional - defaults shown)
# LEI_DELTA_SYNC_INTERVAL=1h          # Delta sync frequency (default: 1h)
# LEI_FULL_SYNC_DAY=Sunday            # Full sync day (default: Sunday)
# LEI_FULL_SYNC_TIME=12:00            # Full sync time HH:MM (default: 12:00)
# LEI_CLEANUP_TIME=03:00              # Cleanup time HH:MM (default: 03:00)

# LEI File Cleanup
# LEI_KEEP_FULL_FILES=2               # Keep last N full files (default: 2)
# LEI_KEEP_DELTA_FILES=5              # Keep last N delta files (default: 5)

# ⚠️  Replace with the RabbitMQ credentials set above: amqp://USER:PASS@rabbitmq:5672/
RABBITMQ_URL=CHANGE_ME_REQUIRED
# ⚠️  Set a long, randomly generated JWT secret (at least 32 characters). Never commit real values.
JWT_SECRET=CHANGE_ME_REQUIRED
SERVER_PORT=8080
SERVER_MODE=release
# File logging is enabled by default; unset LOG_FILE_PATH to disable and log to stdout only
LOG_FILE_PATH=/root/log/backend.log
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:38080
NEXT_PUBLIC_ENVIRONMENT=prod
