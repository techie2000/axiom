# Development Environment Configuration
COMPOSE_PROJECT_NAME=axiom-dev
ENVIRONMENT=dev

# Port Configuration (Prefix: 1)
POSTGRES_PORT=15432
RABBITMQ_PORT=15672
RABBITMQ_MGMT_PORT=15673
BACKEND_PORT=18080
FRONTEND_PORT=13000
DOCS_USER_PORT=15173

# Database Configuration
POSTGRES_USER=axiom
POSTGRES_PASSWORD=axiom_dev_pass
POSTGRES_DB=axiom_dev
# Canonical host bind-mount path for postgres data (main/dev use bind mounts; uat/prod use named Docker volumes).
# Single source of truth: docker-compose.dev.yml references this as ${POSTGRES_DATA_DIR}:/var/lib/postgresql/data,
# and the upgrade-postgres scripts read it to detect and correctly handle bind-mount environments.
POSTGRES_DATA_DIR=./data/dev/postgres

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Backend Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=axiom
DATABASE_PASSWORD=axiom_dev_pass
DATABASE_LOGLEVEL=warn  # Options: silent, error, warn, info (warn suppresses 'record not found' logs)
DATABASE_NAME=axiom_dev
LEI_DATADIR=/root/data/lei  # Inside container, mapped to ./data/dev/lei on host

# LEI Sync Schedules (all optional - defaults shown)
# LEI_DELTA_SYNC_INTERVAL=1h          # Delta sync frequency: 1h, 30m, 2h, etc. (default: 1h)
# LEI_FULL_SYNC_DAY=Sunday            # Full sync day: Sunday, Monday, etc. (default: Sunday)
# LEI_FULL_SYNC_TIME=02:00            # Full sync time: HH:MM format (default: 02:00)
# LEI_CLEANUP_TIME=03:00              # Cleanup time: HH:MM format (default: 03:00)

# LEI File Cleanup - keep only the latest day's data to conserve disk space
LEI_KEEPFULLFILES=1                 # Keep only the latest full file (~1.8 GB)
LEI_KEEPDELTAFILES=1                # Keep only the latest delta file (~65 MB)

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
JWT_SECRET=development-secret-change-in-production
SERVER_PORT=8080
SERVER_MODE=debug
# File logging is enabled by default; unset LOG_FILE_PATH to disable and log to stdout only
LOG_FILE_PATH=/root/log/backend.log
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=3
LOG_MAX_AGE_DAYS=7
LOG_COMPRESS=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:18080
NEXT_PUBLIC_ENVIRONMENT=dev

# Sentry Error Tracking (optional – leave empty to disable)
# Set SENTRY_DSN to your project DSN from https://sentry.io or your self-hosted instance.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_ORG=
SENTRY_PROJECT=axiom-frontend
# SENTRY_AUTH_TOKEN is required only for uploading source maps during production builds.
# Keep it in your CI secrets; never commit a real token here.
SENTRY_AUTH_TOKEN=
