{
  "chat.tools.terminal.autoApprove": {
    ".Name": true,
    ".vscode/settings.json": true,
    "/^(cd \\.\\.; )?pwsh \\./scripts/run-main-compose\\.ps1 .*$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^docker rm -f axiom-main-frontend; docker volume rm axiom-main_frontend_node_modules_main axiom-main_frontend_next_main; pwsh -NoProfile -ExecutionPolicy Bypass -File \\./scripts/run-main-compose\\.ps1 up -d frontend$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^node --check frontend/scripts/extract-i18n-keys\\.mjs$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pwsh -NoProfile -ExecutionPolicy Bypass -File \\./scripts/run-main-compose\\.ps1 stop -t 45 frontend backend$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pwsh -NoProfile -ExecutionPolicy Bypass -File \\./scripts/run-main-compose\\.ps1 stop frontend; docker volume rm axiom-main_frontend_node_modules_main axiom-main_frontend_next_main; pwsh -NoProfile -ExecutionPolicy Bypass -File \\./scripts/run-main-compose\\.ps1 up -d --build frontend$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^pwsh -NoProfile -ExecutionPolicy Bypass -File \\./scripts/run-main-compose\\.ps1 up -d --build postgres rabbitmq backend frontend$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^Set-Location backend; go test \\./internal/repository; Set-Location \\.\\.; node --check frontend/scripts/extract-i18n-keys\\.mjs$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "%": true,
    "code": true,
    "ConvertFrom-Json": true,
    "ConvertTo-Json": true,
    "Copy-Item": true,
    "diskpart": true,
    "docker build": true,
    "docker builder": true,
    "docker compose": true,
    "docker container": true,
    "docker cp": true,
    "docker exec": true,
    "docker image": true,
    "docker images": true,
    "docker inspect": true,
    "docker logs": true,
    "docker network": true,
    "docker pause": true,
    "docker ps": true,
    "docker pull": true,
    "docker restart": true,
    "docker rm": true,
    "docker rmi": true,
    "docker run": true,
    "docker start": true,
    "docker stop": true,
    "docker tag": true,
    "docker volume": true,
    "docker-compose": true,
    "fc": true,
    "ForEach-Object": true,
    "Get-Command": true,
    "Get-Item": true,
    "Get-Process": true,
    "Get-PSDrive": true,
    "gh": true,
    "git -C ..": true,
    "git -C $repo": true,
    "git add": true,
    "git check-ignore": true,
    "git checkout": true,
    "git cherry": true,
    "git commit": true,
    "git fetch": true,
    "git hash-object": true,
    "git ls-tree": true,
    "git merge": true,
    "git push": true,
    "git remote": true,
    "git restore": true,
    "git rev-list": true,
    "git rev-parse": true,
    "git stash": true,
    "git switch": true,
    "git worktree": true,
    "go": true,
    "gofmt": true,
    "make": true,
    "markdownlint": true,
    "migrate": true,
    "mkdir": true,
    "Move-Item": true,
    "npm --prefix frontend": true,
    "npm install": true,
    "npm run -s i18n:verify": true,
    "npm run build": true,
    "npm run docs:build": true,
    "npm run i18n:check": true,
    "npm run i18n:verify": true,
    "npm run lint": true,
    "npm test": true,
    "npx --no-install markdownlint-cli2": true,
    "npx --yes markdownlint-cli2": true,
    "npx markdownlint-cli2": true,
    "Out-Null": true,
    "Pop-Location": true,
    "println": true,
    "psql": true,
    "Push-Location": true,
    "Set-Content": true,
    "sqlfluff": true,
    "Start-Process": true,
    "Tee-Object": true,
    "Test-Path": true,
    "Write-Error": true,
    "wsl": true
  },
  "cSpell.customDictionaries": {
    "axiom-words": {
      "addWords": true,
      "description": "Project-specific accepted words",
      "name": "axiom-words",
      "path": "${workspaceFolder}/.vscode/axiom-words.txt",
      "scope": "workspace"
    }
  },
  "cSpell.ignorePatterns": [
    "backend/bin/**",
    "backend/go.mod",
    "backend/go.sum",
    "bin/**",
    "docs-user/.vitepress/cache/**",
    "docs-user/.vitepress/dist/**",
    "docs-user/node_modules/**",
    "docs-user/package-lock.json",
    "frontend/.next/**",
    "frontend/coverage/**",
    "frontend/node_modules/**",
    "frontend/package-lock.json",
    "frontend/tsconfig.tsbuildinfo"
  ],
  "cSpell.ignoreRegExpList": [
    "/[0-9a-f]{40,}/i",
    "/github\\.com\\/[a-zA-Z0-9\\-_.]+\\/[a-zA-Z0-9\\-_.]+/"
  ],
  "cSpell.language": "en,en-GB",
  "files.exclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "files.watcherExclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "go.toolsEnvVars": {
    "GOPROXY": "direct"
  },
  "gopls": {
    "directoryFilters": [
      "-worktrees",
      "-backend/worktrees",
      "-backups",
      "-**/worktrees",
      "-**/backups"
    ]
  },
  "search.exclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "sqlfluff.dialect": "postgres",
  "sqlfluff.executablePath": "sqlfluff",
  "sqlfluff.experimental.format.executeInTerminal": false,
  "sqlfluff.format.enabled": true,
  "sqlfluff.linter.run": "onSave"
}
