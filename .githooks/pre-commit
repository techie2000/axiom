#!/bin/sh
# Pre-commit hook to validate markdown files
# Install: git config core.hooksPath .githooks

if git diff --cached --name-only --diff-filter=ACM | grep -Fx "frontend/next-env.d.ts" > /dev/null 2>&1; then
    echo ""
    echo "❌ Commit blocked: frontend/next-env.d.ts is generated by Next.js and must not be committed."
    echo "   Run: git restore --staged frontend/next-env.d.ts"
    echo "   If your working tree is dirty too: git restore frontend/next-env.d.ts"
    echo ""
    exit 1
fi

if [ -f ".vscode/settings.json" ]; then
    if command -v pwsh > /dev/null 2>&1; then
        echo "Sorting .vscode/settings.json..."
        if ! pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/sort-vscode-settings.ps1; then
            echo "❌ Failed to sort .vscode/settings.json"
            exit 1
        fi

        # Keep index in sync if the sorter changed the file.
        if ! git diff --quiet -- .vscode/settings.json; then
            git add .vscode/settings.json
            echo "✅ Sorted and staged .vscode/settings.json"
        fi
    else
        echo "⚠️  pwsh not found; skipping settings sort"
    fi
fi

if [ -f "frontend/public/data/ra-urls.json" ]; then
    if command -v pwsh > /dev/null 2>&1; then
        echo "Sorting frontend/public/data/ra-urls.json..."
        if ! pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/sort-ra-urls.ps1; then
            echo "❌ Failed to sort frontend/public/data/ra-urls.json"
            exit 1
        fi

        # Keep index in sync if the sorter changed the file.
        if ! git diff --quiet -- frontend/public/data/ra-urls.json; then
            git add frontend/public/data/ra-urls.json
            echo "✅ Sorted and staged frontend/public/data/ra-urls.json"
        fi
    else
        echo "⚠️  pwsh not found; skipping RA URL sort"
    fi
fi

echo "Running markdown linting..."

# Check if npx is available for markdownlint-cli2
if ! command -v npx > /dev/null 2>&1; then
    echo "❌ npx not found. Install Node.js/npm to run markdownlint-cli2"
    echo "   or install prerequisites with: make install-tools"
    exit 1
fi

# Get list of staged markdown files
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$')

if [ -z "$STAGED_MD_FILES" ]; then
    echo "✅ No markdown files to lint"
    exit 0
fi

echo "Linting markdown files:"
echo "$STAGED_MD_FILES"

# Run markdownlint-cli2 on staged files using local dependencies only (no network installs in hooks)
if git diff --cached --name-only --diff-filter=ACM -z | tr '\0' '\n' | grep '\.md$' | tr '\n' '\0' | xargs -0 npx --no-install markdownlint-cli2 --config .markdownlint.yaml; then
    echo "✅ Markdown linting passed"
    exit 0
else
    echo ""
    echo "❌ Markdown linting failed!"
    echo ""
    echo "Common fixes:"
    echo "  - MD013: Line length exceeds 120 characters - break into multiple lines"
    echo "  - MD040: Fenced code blocks need language specifier (e.g., \`\`\`bash, \`\`\`json, \`\`\`text)"
    echo "  - MD060: Table columns need proper spacing"
    echo ""
    echo "To fix automatically (where possible):"
    echo "  make lint-docs-fix"
    echo "  or: npx --no-install markdownlint-cli2 --config .markdownlint.yaml --fix <file>.md"
    echo ""
    echo "If markdownlint-cli2 is missing, install project tools first:"
    echo "  make install-tools"
    echo ""
    echo "To skip this check (not recommended):"
    echo "  git commit --no-verify"
    exit 1
fi
